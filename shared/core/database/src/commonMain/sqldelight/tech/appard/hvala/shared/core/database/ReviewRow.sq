CREATE TABLE review_row (
    id TEXT NOT NULL PRIMARY KEY,
    seller_id TEXT NOT NULL,
    author_id TEXT,
    author_name TEXT NOT NULL,
    rating INTEGER NOT NULL,
    text TEXT NOT NULL,
    posted_at TEXT NOT NULL,
    listing_title TEXT,
    avatar_color_argb INTEGER NOT NULL,
    reply_text TEXT,
    reply_posted_at TEXT,
    reply_author_name TEXT
);

countAll:
SELECT COUNT(*)
FROM review_row;

selectForSeller:
SELECT *
FROM review_row
WHERE seller_id = ?
ORDER BY posted_at DESC;

selectById:
SELECT *
FROM review_row
WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO review_row(
    id,
    seller_id,
    author_id,
    author_name,
    rating,
    text,
    posted_at,
    listing_title,
    avatar_color_argb,
    reply_text,
    reply_posted_at,
    reply_author_name
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateReply:
UPDATE review_row
SET reply_text = ?,
    reply_posted_at = ?,
    reply_author_name = ?
WHERE id = ?;

deleteAll:
DELETE FROM review_row;
