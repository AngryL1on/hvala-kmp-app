CREATE TABLE favorite_row (
    listing_id TEXT NOT NULL PRIMARY KEY
);

selectAll:
SELECT listing_id
FROM favorite_row;

isFavorite:
SELECT EXISTS(
    SELECT 1
    FROM favorite_row
    WHERE listing_id = ?
);

insert:
INSERT OR REPLACE INTO favorite_row(listing_id)
VALUES (?);

delete:
DELETE FROM favorite_row
WHERE listing_id = ?;

deleteAll:
DELETE FROM favorite_row;
